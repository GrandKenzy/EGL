include "sdl3" as C_SDL3
import standard

struct Rect:
    int x
    int y
    int w
    int h

struct FRect:
    float x
    float y
    float w
    float h

struct Event:
    uint32 type
    uint32 _p1
    uint64 _p2
    uint64 _p3
    uint64 _p4
    uint64 _p5
    uint64 _p6
    uint64 _p7
    uint64 _p8
    uint64 _p9
    uint64 _p10
    uint64 _p11
    uint64 _p12
    uint64 _p13
    uint64 _p14
    uint64 _p15
    uint64 _p16

enum EventType:
    QUIT = 256

uint32 EVENT_QUIT = 256

__inline__ bool init(uint flags): return C_SDL3.SDL_Init(flags)
__inline__ void quit(): C_SDL3.SDL_Quit()
__inline__ pstring get_error(): return C_SDL3.SDL_GetError()
__inline__ void clear_error(): C_SDL3.SDL_ClearError()

__inline__ ptr create_window(pstring title, int width, int height, uint64 flags): return C_SDL3.SDL_CreateWindow(title, width, height, flags)
__inline__ void destroy_window(ptr window): C_SDL3.SDL_DestroyWindow(window)
__inline__ bool show_window(ptr window): return C_SDL3.SDL_ShowWindow(window)
__inline__ bool hide_window(ptr window): return C_SDL3.SDL_HideWindow(window)

__inline__ ptr create_renderer(ptr window, pstring name): return C_SDL3.SDL_CreateRenderer(window, name)
__inline__ void destroy_renderer(ptr renderer): C_SDL3.SDL_DestroyRenderer(renderer)
__inline__ bool set_draw_color(ptr renderer, uint8 r, uint8 g, uint8 b, uint8 a): return C_SDL3.SDL_SetRenderDrawColor(renderer, r, g, b, a)
__inline__ bool clear(ptr renderer): return C_SDL3.SDL_RenderClear(renderer)
__inline__ bool present(ptr renderer): return C_SDL3.SDL_RenderPresent(renderer)
__inline__ bool draw_point(ptr renderer, float x, float y): return C_SDL3.SDL_RenderPoint(renderer, x, y)
__inline__ bool draw_line(ptr renderer, float x1, float y1, float x2, float y2): return C_SDL3.SDL_RenderLine(renderer, x1, y1, x2, y2)
__inline__ bool draw_rect(ptr renderer, ptr rect): return C_SDL3.SDL_RenderRect(renderer, rect)
__inline__ bool fill_rect(ptr renderer, ptr rect): return C_SDL3.SDL_RenderFillRect(renderer, rect)

__inline__ bool poll_event(ptr event): return C_SDL3.SDL_PollEvent(event)
__inline__ void pump_events(): C_SDL3.SDL_PumpEvents()

__inline__ void delay(uint32 ms): C_SDL3.SDL_Delay(ms)
__inline__ uint64 get_ticks(): return C_SDL3.SDL_GetTicks()
