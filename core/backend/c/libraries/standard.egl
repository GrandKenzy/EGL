public class str:
    ptr _ptr
    uint64 _len

    void __new__():
        __void_p_t__ __char_t__ value 
        value = __fronted__ 
        __size_t__ size = STRING_C.strlen(value)
        self._ptr = C_STDLIB.malloc((char.size * size) + 1)
        self._len = size
        STRING_C.strcpy(self._ptr, value)

    void __init__():
        pass

    @method
    int len():
        return self._len
        







